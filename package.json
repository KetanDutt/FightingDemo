{
  "name": "fighting-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Monkey Mayhem - a polished 2D fighting game demo built with Phaser 3, reverse-engineered and rebuilt from the original FightingDemo prototype.",
  "type": "module",
  "keywords": [
    "phaser",
    "phaser3",
    "game",
    "fighting-game",
    "html5",
    "canvas",
    "webgl"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/*.test.mjs\" && node tests/smoke.test.mjs",
    "analyze:assets": "node tools/analyze-atlases.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:smoke": "node tests/smoke.test.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\""
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "phaser3spectorjs": "^0.0.8",
    "prettier": "^3.6.2",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
